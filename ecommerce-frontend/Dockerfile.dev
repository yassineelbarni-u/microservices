# ============================================================
# Dockerfile.dev — Angular Dev Server (Hot-Reload)
# Compatible podman-compose et docker-compose
# ============================================================

FROM node:22-alpine

WORKDIR /app

# 1. Copier les manifestes npm en premier (cache Docker optimal)
COPY package.json package-lock.json ./

# 2. Installer les dépendances dans le conteneur
RUN npm ci

# 3. Copier TOUS les fichiers du workspace Angular
#    (node_modules est exclu via .dockerignore)
COPY . .

# Le dossier src/ est remplacé par un volume bind-mount dans docker-compose
# pour activer le hot-reload sans rebuild de l'image

EXPOSE 4200

CMD ["npm", "run", "start:docker"]


